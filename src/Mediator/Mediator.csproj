<Project Sdk="Atya.Build.Sdk">

  <PropertyGroup>
    <AssemblyName>Atya.Application.Mediator</AssemblyName>
    <PackageId>Atya.Application.Mediator</PackageId>
    <RootNamespace>Atya.Application.Mediator</RootNamespace>
    <IsPackable>true</IsPackable>
    <Authors>Arsen Asulyan</Authors>
    <Company>Atya</Company>
    <Copyright>Copyright (c) 2026 Arsen Asulyan</Copyright>
    <Description>Source-generated, reflection-free mediator contracts and dispatch for .NET applications.</Description>
    <PackageTags>dotnet;atya;mediator;source-generator;results</PackageTags>
    <RepositoryUrl>https://github.com/AtyaLibraries/Mediator</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>

    <!-- MinVer derives the version from git tags (e.g. tag `v1.2.3` -> 1.2.3). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <NoWarn Condition="'$(RepositoryUrl)' != '' And $(RepositoryUrl.Contains('__'))">$(NoWarn);CA1707;SA1300</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\Mediator.SourceGeneration\bin\$(Configuration)\netstandard2.0\Atya.Application.Mediator.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Runtime dependency">
    <PackageReference Include="Atya.Foundation.Guards" />
    <PackageReference Include="Atya.Foundation.Results" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Analyzer dependency">
    <ProjectReference Include="..\Mediator.SourceGeneration\Mediator.SourceGeneration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
